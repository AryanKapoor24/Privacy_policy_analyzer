# Groq API Key (FREE)
# Get your free key from: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# Groq model and endpoint (OpenAI-compatible)
# Most stable/available: llama-3.1-8b-instant
# ⚠️ If you get 404 "model not found", visit https://console.groq.com/docs/models
# and find YOUR account's available models, then update GROQ_MODEL here
GROQ_MODEL=llama-3.1-8b-instant
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions

# Python RAG server URL
PYTHON_API_URL=http://localhost:8000

# Server port (optional)
PORT=3001
